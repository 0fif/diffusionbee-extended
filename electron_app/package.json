{
  "name": "diffusionbee-extended",
  "version": "0.1.0-beta.1",
  "build_number": "0029",
  "website": "https://github.com/0fif/diffusionbee-extended",
  "description": "Independent DiffusionBee fork with modern local image generation and editing.",
  "is_dev": false,
  "private": true,
  "scripts": {
    "test:export": "electron tests/image-export.cjs",
    "test:editor": "electron tests/editor.cjs",
    "electron:serve:release": "node scripts/serve-release.cjs",
    "serve": "vue-cli-service serve",
    "serve:ui": "vue-cli-service serve ./src/main_demoui.js",
    "build:ui": "vue-cli-service build ./src/main_demoui.js",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "electron:build": "vue-cli-service electron:build",
    "electron:serve": "vue-cli-service electron:serve",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps",
    "test:mflux": "node tests/mflux.cjs",
    "setup:mflux": "node scripts/setup-mflux.cjs",
    "test:downloads": "node tests/model-download.cjs",
    "test:generation": "node tests/generation-status.cjs",
    "test:models": "node tests/model-details.cjs && node tests/model-previews.cjs && electron tests/model-store.cjs",
    "test:preload": "electron tests/preload.cjs",
    "test:history": "electron tests/history.cjs",
    "test:legacy": "node tests/legacy-tools.cjs",
    "stage:runtime": "node scripts/stage-runtime.cjs",
    "package:local": "vue-cli-service electron:build --mac --arm64 --dir --publish never",
    "test:runtime": "node tests/runtime-paths.cjs",
    "package:release": "EXTENDED_RELEASE=1 vue-cli-service electron:build --mac --arm64 --publish never"
  },
  "main": "background.js",
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "@fortawesome/vue-fontawesome": "3.3.3",
    "bootstrap": "^5.3.8",
    "core-js": "^3.8.3",
    "electron-context-menu": "^3.5.0",
    "electron-localshortcut": "^3.2.1",
    "electron-notarize": "^1.2.1",
    "electron-settings": "^4.0.2",
    "fuse.js": "^6.6.2",
    "javascript-time-ago": "^2.3.13",
    "js-yaml": "^4.1.0",
    "konva": "^8.3.13",
    "nsfwjs": "^2.4.2",
    "path": "^0.12.7",
    "stream": "^0.0.2",
    "vue": "3.5.44",
    "vue-spinner": "^1.0.4",
    "vue-toast-notification": "3.1.3",
    "bootstrap-vue-next": "1.2.2",
    "@fortawesome/fontawesome-svg-core": "^1.2.36"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "babel-eslint": "^10.1.0",
    "electron": "45.2.2",
    "electron-builder": "^23.3.3",
    "electron-devtools-installer": "^3.1.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "vue-cli-plugin-electron-builder": "^2.1.1",
    "@vue/compiler-sfc": "3.5.44"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "rules": {
      "vue/multi-word-component-names": "off",
      "vue/no-mutating-props": "off"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "productName": "DiffusionBee Extended",
  "overrides": {
    "vue-cli-plugin-electron-builder": {
      "electron-builder": "$electron-builder"
    }
  }
}
